# ─────────────────────────────────────────────────────────────
#  GlobalHub (멀티테넌트) — 신규 Supabase 프로젝트를 사용한다.
#  경성전자고(1cl_MsGPT) DB 와는 완전히 별개. 절대 재사용 금지.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
#  Client build (Vite)  — baked into the browser bundle
# ─────────────────────────────────────────────────────────────
# Only the project origin, used to build public student-photo URLs.
# NOT a secret. 신규 GlobalHub 프로젝트 origin 으로 반드시 설정.
VITE_PUBLIC_SUPABASE_URL=https://your-globalhub-project.supabase.co

# (Gemini keys, if used, come from localStorage at runtime — do NOT put keys here)

# ─────────────────────────────────────────────────────────────
#  Server only  — Netlify env vars + local node scripts
#  NEVER expose these to the browser / never prefix with VITE_
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# HMAC secret for signing teacher session tokens (>= 32 random chars).
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SIGNING_SECRET=change_me_to_a_long_random_string

# 셀프 학교개설(/start) 가입 코드 — 설정하면 개설 시 이 코드 필요. 비우면 공개.
SIGNUP_CODE=

# ── 도메인 자동 연결 (선택) — 4개 모두 있어야 signup 이 도메인을 자동 붙임 ──
# 없으면 학교 생성만 하고 도메인 연결은 수동 안내.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=          # creat1324.com 이 팀 소속이면 team id(team_...) 또는 slug
NETLIFY_API_TOKEN=       # app.netlify.com → User settings → Applications → Personal access tokens
NETLIFY_SITE_ID=         # 1cl-global 사이트: Site configuration → General → Site information → API ID

# Migration / backup script settings
ACADEMIC_YEAR=2026
RESIZE_WIDTH=1200
IMAGE_QUALITY=80
